# Автономное демо по умолчанию. Скопируйте в .env при необходимости.
DEMO_MODE=1
# DATABASE_PATH=data/app.db
# Доступы из инструкции организаторов нужны только для команды snapshot.
EKT_API_USERNAME=
EKT_API_PASSWORD=

# H2: live-режим требует ключ и явно выбранную модель со structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Разрешённые origin для локального Vite; в production укажите свои адреса.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
